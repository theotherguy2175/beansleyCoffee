# Copy to server/.env for local dev (or supply as env vars / K8s Secret in prod)

NODE_ENV=development
PORT=4001

# SQLite paths — in prod these should point into the mounted PVC, e.g. /data/db.sqlite
DB_PATH=./local.sqlite
SESSIONS_DB_PATH=./local-sessions.sqlite
UPLOADS_DIR=./uploads

# Random long string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Gmail SMTP — create an App Password at https://myaccount.google.com/apppasswords
# All three below are optional at boot; whatever's missing here can be filled
# in later from the admin Settings page (stored in the DB, takes precedence).
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
MAKER_NOTIFICATION_EMAIL=maker@example.com

# Created automatically on first boot if no admin exists yet
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please-8chars-min
BOOTSTRAP_ADMIN_NAME=Admin
